# ── demo.redis ── full example from requirements §3.1 ───────────────────
# Manual test: <CR> on any line executes it; :PosteRedisRunFile runs the whole
# file (one tab per command)

# ── connection & db ──────────────────────
USE local              # switch to the `local` connection in connections.toml
SELECT 0               # a real Redis command: switch db (M1 exec mode, fresh process per run)

set a:b:c:d "abcd"
set a:d "ad"
set a:c:d:e "ad"
set 1:2:3:4:5:6 "deep"
set 1:2:3:4:5:51 "deep"
set 1:2:3:4:41 "deep"
set 2:3:4:5:6 "deep"

set a:b:c "abc"
get a:b:c
set b:c "bc"
set a:b "ab"
set a:d "ad"
set a:a_very_long_key:very_very_long "long long key"

# ── String ──
SET session:abc "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0In0" EX 3600
GET session:abc
GET missing:key          # should be (nil)

TYPE user:42

# ── Hash: long commands use \ continuations ──
HSET user:42 name "Alice" \
      email "alice@example.com" \
      age 30
HGETALL user:42          # renders as a field/value table
# DEL user:42
# DEL session:abc

# ── List ──
RPUSH queue:jobs "job-1" "job-2" "job-3"
LRANGE queue:jobs 0 -1   # numbered list

# ── Set ──
SADD tags:dev vim lua redis
SMEMBERS tags:dev
SADD tags:dev rust java c++ vue react

# ── ZSet ──
ZADD board 99 alice 87 bob
ZREVRANGE board 0 -1 WITHSCORES   # member/score table
ZRANGE board 0 -1 WITHSCORES   # member/score table

# redis-cli --scan --pattern 'a:a_very_long_key:*' | xargs redis-cli del

# ── Integer / status ──
INCR counter:hits
EXISTS session:abc       # 1 / 0

# ── quoting rules: double quotes (JSON-compatible escapes), single quotes,
#    bare words; # inside quotes is not a comment ──
LPUSH queue:email '{"to":"a@b.c","tpl":"welcome"}'   # single-quoted literal
LRANGE queue:email 0 -1
SET note "this # is inside quotes"
SET plain bareword
GET note
GET plain

# ── cleanup: dangerous commands (M1 shows a yellow warning, does not block) ──
DEL user:42 queue:jobs tags:dev board counter:hits note plain queue:email

-- @connection local
ZADD leaderboard:test:demo 920 "player_a"
ZADD leaderboard:test:demo 850 "player_b"
ZADD leaderboard:test:demo 780 "player_c"
ZADD leaderboard:test:demo 640 "player_d"
ZADD leaderboard:test:demo 510 "player_e"
ZREVRANGE leaderboard:test:demo 0 4 WITHSCORES
ZREVRANK leaderboard:test:demo "player_c"
ZSCORE leaderboard:test:demo "player_b"
ZINCRBY leaderboard:test:demo 120 "player_c"
ZREVRANGE leaderboard:test:demo 0 4 WITHSCORES

SELECT 1

KEYS *
HGETALL svc:search:index:tags:shard:0:stat

USE local-db2
SELECT 0

KEYS  *
HGETALL  node:node-02:stats
