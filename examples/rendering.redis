# ── rendering.redis ── value rendering focus (five shapes + binary + big
#    values + stream) ──
# Manual test points: <CR> line by line to inspect panel rendering; K previews
# raw JSON; yy copies the current tab
# Note: M1 spawns a fresh process per execution; SET/DEL in this file run in
# order, the last line cleans up

USE local

# ── binary values: non-UTF-8 bytes should render as a hex digest + byte count ──
# Writing "\xff" literally sends it as text (valid UTF-8, no binary path); use EVAL to build real bytes:
EVAL "return string.char(255,254,0,72,105)" 0

# ── big String: >64KB should truncate and show truncated ──
# The line below writes 70KB in one shot (pad the a's to 70000 by hand, or use EVAL+SETRANGE):
# SETRANGE big-value 0 "aaaa....(70000 of them)"
SET big-value "small-for-now"
GET big-value

# ── empty collections: should render (empty list)/(empty hash) etc ──
LRANGE empty-list 0 -1
SMEMBERS empty-set
HGETALL empty-hash
ZRANGE empty-zset 0 -1

# ── stream: id + fields rendering ──
XADD stream:events 1690000000000-0 to "a@b.c" tpl "welcome"
XADD stream:events 1690000001000-0 to "d@e.f" tpl "reminder"
XRANGE stream:events - +

# ── integer / status ──
INCR visits
SET counter 41
INCR counter
GET counter

# ── cleanup ──
DEL binary-key big-value empty-list empty-set empty-hash empty-zset stream:events visits counter
