# ── parser_edges.redis ── parser edge cases (EXECUTION-PLAN §4.2 test matrix) ──
# Manual test points: <CR> on any physical line inside a continuation should
# extract the same single command

USE local

# ── continuation: a trailing \ joins the next physical line (works with
#    trailing whitespace too) ──
SET multi-line "value is " \
    .. "concatenated across lines"

LPUSH queue:big item1 item2 \
      item3 item4 \
      item5

# ── # inside quotes is not a comment ──
SET quoted "# start-of-token-not-comment"
GET quoted

LPUSH queue:hash '{"k":"v#1"}'

# ── inline comment (everything after a bare # is a comment) ──
SET with-inline-ok yes # rest is comment, not parsed
GET with-inline-ok

# ── whole-line comments (both # and -- are supported) ──
# hash style comment
-- dash style comment
GET with-inline-ok

# ── command names are case-insensitive ──
set case-test "lowercase cmd works"
Get case-test
gEt case-test

# ── empty lines / comment-only lines produce no command ──

# ── CRLF line endings (vim usually normalises on save; documented here) ──
SET crlf-test "line"
GET crlf-test

# ── dangerous commands (M1 warns in yellow, does not block) ──
# FLUSHALL
# FLUSHDB
# SHUTDOWN NOSAVE
CONFIG GET maxmemory

# ── cleanup ──
DEL multi-line queue:big quoted queue:hash with-inline-ok case-test crlf-test
