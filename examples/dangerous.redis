# ── dangerous.redis ── dangerous commands (M1: yellow warning, no blocking;
#    M3: full blocking) ──
# Manual test points: <CR> on any line, the result panel winbar should show a
# yellow warning; run these against a read-only/test db and double-check which
# db the current USE points to

USE local

# ── look at the current db first (don't actually flush it) ──
DBSIZE
KEYS *

# ── dangerous commands (try one at a time with <CR>; never run the whole file!) ──
# FLUSHDB
# FLUSHALL
# SHUTDOWN NOSAVE
# CONFIG SET save ""
CONFIG GET save
CONFIG RESETSTAT
DEBUG OBJECT some-key

# ── not dangerous but easy to hurt yourself: DEL a whole prefix (confirm dialog lands in M3) ──
# DEL demo:* user:* queue:*
