# ── multi_use.redis ── connection-switching focus ───────────────────────
# Manual test points:
#   - USE switches connections: SET writes to the current connection and GET
#     reads it back (verify per USE segment)
#   - bare USE (alone on a line): should open the connection picker
#   - no USE segment: :PosteRedisRunFile should error and suggest
#     :PosteRedisConnection
# Note: in M1 each segment spawns its own redis-exec process, so SELECT state
# does not persist across segments

# ── segment 1: local (db0) ──
USE local
SET whoami "db0-user"
GET whoami

# ── segment 2: local-db2 (db1) — SET and GET share a USE segment, state consistent ──
USE local-db2
SET whoami "db1-user"
GET whoami          # should read the db1 value
GET db0-copy        # missing (db1 is empty)

# ── switch back to local, verify the db0 value was not polluted ──
USE local
GET whoami          # should still be "db0-user"

# ── bare USE: uncomment the line below, put the cursor on it and press <CR>;
#    the connection picker should open ──
# USE

# ── cleanup ──
USE local
DEL whoami
USE local-db2
DEL whoami
